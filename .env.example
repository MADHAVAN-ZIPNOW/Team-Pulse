# Copy this file to ".env" in the pr-assistant folder (next to README.md) and fill it in.

# Microsoft Entra ID
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/auth/callback
FRONTEND_URL=http://localhost:5173
# Long random string, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# Azure DevOps
AZURE_DEVOPS_API_VERSION=7.1

# Claude Code (uses your Claude subscription login - NO API key)
# Absolute path to a local checkout of the repository the PRs belong to.
# Windows example: C:/src/my-repo
LOCAL_REPO_PATH=/absolute/path/to/your/local/repository

# Server
BACKEND_PORT=8000

# Optional: set to false only if your browser rejects Secure cookies on http://localhost (e.g. Safari)
# COOKIE_SECURE=true

# Sign-in mode: "msal" (default, Entra app registration above) or "azure_cli" (device code via `az login`;
# needs Azure CLI installed, and no AZURE_CLIENT_ID / SECRET / TENANT).
# AUTH_MODE=azure_cli

# --- Hosted (Render) only ---
# Comma-separated sign-in emails allowed to use the app (protects the shared Claude subscription). Empty = anyone in the tenant.
# ALLOWED_USERS=you@yourcompany.com,teammate@yourcompany.com
# Long-lived Claude subscription token from `claude setup-token`. Set as a Render secret, never commit it.
# CLAUDE_CODE_OAUTH_TOKEN=

# Stay signed in: sessions are saved encrypted here (default: a temp folder). On Render use a persistent disk path.
# SESSION_DIR=/var/data/sessions
# SESSION_TTL_DAYS=30

# Claude models people can pick in the chat (first one is the default). Aliases sonnet/opus/haiku always use the newest the installed Claude Code knows.
# CLAUDE_MODELS=sonnet=Claude Sonnet;opus=Claude Opus;haiku=Claude Haiku

# --- Google Trends page (nothing is stored; lists are read live from Google and kept in memory only) ---
# TRENDS_ENABLED=true
# Countries merged for "Worldwide" (two-letter codes). Any single country can be picked in the UI.
# TRENDS_REGIONS=IN,US,GB,CA,AU,DE,FR,JP,BR,SG
# How long a list is reused from memory before Google is read again (the page updates itself).
# TRENDS_CACHE_SECONDS=180
# Claude models: quick jobs (naming categories) and web research (a trend's photo/analysis, old dates).
# TRENDS_MODEL=haiku
# TRENDS_RESEARCH_MODEL=sonnet

# --- Recordings -> text, free and local (Whisper). "small" is quick; "medium" is better for Tamil but slower. Empty turns it off.
# WHISPER_MODEL=medium

# --- Meetings: Claude creates Azure DevOps work items from what is said in a meeting (WRITES to Azure DevOps: off by default) ---
# MEETING_AGENT_ENABLED=true
# MEETING_AGENT_MODEL=sonnet
# Reading a recording (instead of Teams' own transcript): an Azure AI Speech resource in your tenant, and ffmpeg on the server.
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=centralindia
# SPEECH_LOCALES=en-IN,ta-IN
# FFMPEG_PATH=
# MEETING_UPLOAD_MAX_MB=600
# Saved meetings (encrypted with SESSION_SECRET, which must stay the same between restarts; one private folder per person).
# MEETING_DIR=
# MEETING_RETENTION_DAYS=90

# --- Problem Radar tab: once a day Claude searches the web for real problems in your technology list (needs Claude signed in) ---
# RADAR_ENABLED=true
# RADAR_HOURS=8,14,20      # morning, afternoon, night runs (hours, in RADAR_TZ). Nobody has to press anything.
# RADAR_MAIL_FROM=you@yourcompany.com   # mailbox the report is sent from (needs the Mail.Send APPLICATION permission, admin-approved)
# RADAR_MAIL_TO=a@yourcompany.com,b@yourcompany.com
# RADAR_PAGE_URL=https://your-app.onrender.com/#/radar
# RADAR_TZ=Asia/Kolkata
# RADAR_MODEL=sonnet
# RADAR_WATCHLIST=FastAPI, React, Vite, TypeScript, Python, Docker, Render, Azure DevOps
# RADAR_ROLE=Software engineer
# RADAR_SKILL=Intermediate

# --- Shared Claude accounts (one per person) and the admin switch ---
# Name=token pairs from `claude setup-token`, separated by ; — names appear on the Claude Monitor page.
# SHARED_CLAUDE_TOKENS=Abinaya=sk-ant-...;Monika=sk-ant-...;Dhamu=sk-ant-...
# Who may press "Use for everyone" on the Claude Monitor page (comma-separated sign-in emails).
# ADMIN_EMAILS=you@company.com
# Optional: which account is active after a server restart.
# DEFAULT_CLAUDE_ACCOUNT=Monika
# Extra people emailed when the app-wide Claude account changes (admins and RADAR_MAIL_TO are always included).
# CLAUDE_NOTIFY_TO=a@yourcompany.com,b@yourcompany.com
# Move to the next account when the 5-hour or weekly limit reaches this percent (default 90).
# CLAUDE_SWITCH_PERCENT=90
